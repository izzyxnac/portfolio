# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

 
# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=your-site-name
NEXT_PUBLIC_SITE_TITLE=your-site-title
NEXT_PUBLIC_SITE_DESCRIPTION=your-site-description

# 
NEXT_PUBLIC_GA_ID=your-ga-id
NEXT_PUBLIC_VERCEL_ANALYTICS=your-vercel-analytics
NEXT_PUBLIC_HOTJAR_ID=your-hotjar-id

# Analytics
NEXT_PUBLIC_ANALYTICS_ID=your-vercel-analytics-id

NEXT_PUBLIC_AUTHOR_NAME=your-author-name
NEXT_PUBLIC_AUTHOR_EMAIL=your-email@gmail.com
NEXT_PUBLIC_AUTHOR_GITHUB=your-github
NEXT_PUBLIC_AUTHOR_LINKEDIN=your-linkedin
NEXT_PUBLIC_AUTHOR_TWITTER=your-twitter
NEXT_PUBLIC_API_URL=http://your-api-url
NEXT_PUBLIC_AUTHOR_JOB_TITLE=your-job-title

# Supabase Configuration (if using)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Email Configuration (for contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

#
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_LOG_LEVEL=your-log-level
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=your-enable-error-reporting
VERCEL_PROTECTION_BYPASS=your-verification-token

# Development
NODE_ENV=development