# Local Development Environment Variables
# Copy this file to .env.local for local development

# Site Configuration (Local)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="AI/ML Developer Portfolio - Local"
NEXT_PUBLIC_SITE_DESCRIPTION="Enterprise AI/ML integration specialist - Development Environment"

# Analytics (Disabled for local development)
NEXT_PUBLIC_ANALYTICS_ID=

# Supabase Configuration (Local/Development)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-supabase-service-role-key

# Email Configuration (Development - use test credentials)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=test-user@ethereal.email
SMTP_PASS=test-password

# Development
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
